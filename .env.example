# iTeachXR — Environment Variables
# Copy this to .env for local dev. On Railway, set these in the dashboard.

# ── Database ──────────────────────────────────────────────────
# Primary: Fly.io Postgres (sofaitranscript.fly.dev)
FLY_DATABASE_URL=postgres://user:password@sofaitranscript.fly.dev:5432/dbname?sslmode=require

# Fallback: any Postgres URL (Neon, Supabase, Railway Postgres, etc.)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# ── Google SSO Bridge ──────────────────────────────────────────
# Must match NEXTAUTH_SECRET in the sofai (ai.thevrschool.org) Fly.io app
NEXTAUTH_SECRET=your-shared-secret-here

# Canonical SSO surface — do not change unless you move auth
CANONICAL_AUTH_URL=https://ai.thevrschool.org

# Public domain of this app (no https://, no trailing slash).
# Use the branded domain in production once DNS is attached.
# Temporary Railway staging host: iteachxr-production-d1b8.up.railway.app
APP_DOMAIN=lms.thevrschool.org

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Optional ──────────────────────────────────────────────────
# Force a specific app URL (overrides auto-detection)
# APP_URL=https://lms.thevrschool.org
# APP_URL=https://iteachxr-production-d1b8.up.railway.app
APP_ENV=production
